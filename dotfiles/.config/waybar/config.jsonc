{
    "include": [
        "modules.jsonc"
    ],
    "height": 5,
    "layer": "top",
    "position": "bottom",
    "fixed-center": true,
    "reload_style_on_change": true,
    "modules-left": [
        "niri/workspaces",
        "cffi/niri-taskbar"
    ],
    "modules-center": [
        "custom/cava",
        "custom/screenshot",
        "custom/wfrec",
        "power-profiles-daemon",
        "custom/clipboard",
        "custom/colorpicker",
        "clock"
    ],
    "modules-right": [
        "tray",
        "network",
        "group/ddcutil",
        "privacy",
        "group/audio",
        "battery",
        "group/powermenu"
    ]
}
